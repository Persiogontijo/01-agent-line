# Model Provider: "gemini" (default) or "openai"
CORTEX_PROVIDER=gemini

# Your model provider key
# Gemini: get a key from Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIzaSy...

# OpenAI: fallback if using OpenAI
OPENAI_API_KEY=sk-...

# Model + bounds. Gemini 2.0 Flash is ultra-fast, capable, and cost-effective.
CORTEX_MODEL=gemini-2.0-flash
CORTEX_MAX_ITERATIONS=8       # loop cap: stop + escalate instead of spinning
CORTEX_MAX_REVISIONS=2        # critic<->drafter cap: stop the bounce-forever bomb
CORTEX_COST_CAP_USD=0.50      # hard spend cap per run, enforced outside the model
CORTEX_MAX_QUEUE_ITEMS=10     # commitment cap: max backlog stories queued per run

# Rough $ per 1M tokens for Gemini 2.0 Flash (free tier or $0.075 / $0.30 per 1M)
CORTEX_PRICE_IN_PER_M=0.075
CORTEX_PRICE_OUT_PER_M=0.30
